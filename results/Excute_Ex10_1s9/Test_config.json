{
  "eqn_config": {
    "_comment": "Ex10 of Stochastic Occilation",
    "eqn_name": "SO",
    "dim": 2,
    "Delta": 0.01,
    "mu": [
      [
        0.0,
        1.0
      ],
      [
        -1.0,
        0.0
      ]
    ],
    "sigma": [
      [
        0.0,
        0.0
      ],
      [
        0.0,
        0.1
      ]
    ],
    "resmodel_path": "./pretrainmodel/Ex10SOs01/Best_model/checkpoint",
    "resconfig_path": "./pretrainmodel/Ex10SOs01/Test_config.json",
    "resmodel": "ResNetwM"
  },
  "net_config": {
    "N_rec": 40,
    "n_Z": 20,
    "G_type": "MLP",
    "D_type": "MLP",
    "G_hidden": 4,
    "D_hidden": 4,
    "G_nodes": 80,
    "D_nodes": 80,
    "G_opt": {
      "type_": "Adam",
      "lr": 5e-05,
      "beta_1": 0.5,
      "beta_2": 0.999
    },
    "D_opt": {
      "type_": "Adam",
      "lr": 5e-05,
      "beta_1": 0.5,
      "beta_2": 0.999
    },
    "n_critic": 5,
    "batch_size": 1000,
    "N_epochs": 200000,
    "Test_mode": "Multiple_last",
    "model_name": "WGAN-GP3"
  },
  "dat_config": {
    "TrainData_dir": "./data/Ex10SO/Ex10SO_s01_train.mat",
    "TestData_dir": "./data/Ex10SO/Ex10SO_s01_test.mat",
    "n_ea_traj": 1,
    "N_pred": 10000,
    "zeroinit": false
  },
  "show_config": {
    "plot_samplecompare": true,
    "plot_meancompare": true,
    "plot_losthist": true
  },
  "monitor_config": {
    "pdf_monitor": {
      "if": false,
      "period": 100,
      "points": [
        0.5,
        1.0,
        1.5,
        2.0
      ],
      "int_long": 0.5
    },
    "repdf_display": {
      "if": true,
      "size": [
        4,
        4
      ],
      "range": [
        [
          -1.5,
          1.5
        ],
        [
          -1.5,
          1.5
        ]
      ],
      "times": 20,
      "int_long": [
        0.2,
        0.2
      ]
    },
    "traindata_hist": true,
    "traintransin_hist": true,
    "fake_check": {
      "if": true,
      "times": 20,
      "int_long": 1.5
    },
    "cond_mv": {
      "if": true,
      "Npoint": 20,
      "range": [
        [
          -1.5,
          1.5
        ],
        [
          -1.5,
          1.5
        ]
      ],
      "times": 20
    },
    "Evameanv": {
      "if": true,
      "times": 20,
      "type": "Multiple_last"
    },
    "loss": {
      "if": true,
      "times": 10
    },
    "Ens_monitor": {
      "if": true,
      "Ens_repdf": true,
      "Ens_cond_mv": true,
      "Ens_eva": true
    }
  }
}